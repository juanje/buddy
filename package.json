{
  "name": "ab-app",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "Buddy — native desktop personal assistant with persistent memory (Tauri + Pi SDK)",
  "scripts": {
    "dev": "vite",
    "build:worker": "bash scripts/build-worker.sh",
    "build": "npm run build:worker && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "npm run test:unit && npm run test:bdd",
    "test:unit": "vitest run",
    "test:bdd": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "highlight.js": "^11.11.1",
    "kkrpc": "^2.1.0",
    "marked": "^18.0.6",
    "pdf-parse": "^2.4.5",
    "simple-git": "^3.36.0",
    "svelte": "^5.0.0",
    "tauri-plugin-js-api": "^0.2.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "bun": "^1.3.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
